---
import LastUpdated from "virtual:starlight/components/LastUpdated";
import MarkdownCopy from "./MarkdownCopy.astro";

const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const markdownPath = path === base ? `${base}index.md` : `${path.replace(/\/$/, "")}.md`;
---

<div class="docs-page-meta">
  <LastUpdated />
  <MarkdownCopy />
  <a href={markdownPath}>Markdownで表示</a>
</div>
