---
import DefaultHead from "@astrojs/starlight/components/Head.astro";

const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const isHome = path.replace(/\/$/, "") === base.replace(/\/$/, "");
const markdownPath = isHome ? `${basePath}index.md` : `${path.replace(/\/$/, "")}.md`;
const llmsPath = `${base.replace(/\/$/, "")}/llms.txt`;
---

<DefaultHead />
<link rel="alternate" type="text/markdown" href={markdownPath} />
<link rel="describedby" type="text/markdown" href={llmsPath} />
