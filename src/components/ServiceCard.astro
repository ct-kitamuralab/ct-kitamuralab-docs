---
interface Props {
  category: string;
  title: string;
  description: string;
  icon: "workspace" | "api" | "agent" | "desktop" | "demo" | "experiment";
  status: "available" | "preparing" | "planned" | "experimental";
  statusLabel: string;
  features: string[];
}

const { category, title, description, icon, status, statusLabel, features } = Astro.props;
---

<article class="service">
  <div class="service-topline">
    <p class="service-label">{category}</p>
    <span class:list={["status-badge", `status-${status}`]}>{statusLabel}</span>
  </div>
  <div class:list={["service-icon", `service-icon-${icon}`]} aria-hidden="true">
    {
      icon === "workspace" ? (
        <svg viewBox="0 0 24 24"><path d="m8.5 8-4 4 4 4m7-8 4 4-4 4m-1-11-5 14" /></svg>
      ) : icon === "api" ? (
        <svg viewBox="0 0 24 24"><path d="M7 7h10v10H7zM3 10h4m10 0h4M3 14h4m10 0h4M10 3v4m4-4v4m-4 10v4m4-4v4" /></svg>
      ) : icon === "agent" ? (
        <svg viewBox="0 0 24 24"><path d="M12 3v3M8 6h8a4 4 0 0 1 4 4v7a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3v-7a4 4 0 0 1 4-4Zm1 6h3m-8 0h1m-1 4h8" /></svg>
      ) : icon === "desktop" ? (
        <svg viewBox="0 0 24 24"><path d="M3 5h18v12H3zM8 21h8m-4-4v4" /></svg>
      ) : icon === "demo" ? (
        <svg viewBox="0 0 24 24"><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Zm0 9 8-4.5M12 12 4 7.5M12 12v9" /></svg>
      ) : (
        <svg viewBox="0 0 24 24"><path d="M9 3h6m-5 0v5l-5 9a2.5 2.5 0 0 0 2.2 4h9.6a2.5 2.5 0 0 0 2.2-4l-5-9V3m-6.5 12h9" /></svg>
      )
    }
  </div>
  <div class="service-copy">
    <h3>{title}</h3>
    <p>{description}</p>
    <ul>
      {features.map((feature) => <li>{feature}</li>)}
    </ul>
  </div>
</article>
